{
  "_comment": "Iterative AIMMD-TIS on the Wolfe-Quapp toy potential. 'quick' overrides are applied with --quick.",
  "system_name": "wolfe_quapp_iterative",
  "system": {
    "potential_name": "wolfe-quapp",
    "potential_kwargs": {
      "n_harmonics": 0,
      "rotation_degrees": 0,
      "scale": 2
    },
    "integrator_params": {
      "dt": 0.05,
      "temperature": 1,
      "gamma": 10
    },
    "seed": 1234
  },
  "settings": {},
  "AIMMD_settings": {
    "distribution": "lorentzian",
    "scale": 1.0,
    "activation": "SiLU",
    "use_GPU": false,
    "ee_params": {
      "efficiency_factor": false,
      "lr_0": 0.001,
      "lr_min": 2e-07,
      "epochs_per_train": 5,
      "interval": 5,
      "window": 75,
      "cut_off": 30,
      "cut_off_scaling": 0.999,
      "max_clipping_norm": null,
      "smoothness_penalty_weight": 1e-06,
      "l1_regularization": 0.0,
      "stochastic_gate_regularization": 0.0
    },
    "layers": {
      "0": 64,
      "1": 32
    },
    "dropout": {
      "0": 0.0,
      "1": 0.0
    },
    "_stochastic_gates_comment": "Off for the 2-D potential. For runs with n_harmonics > 0 set enabled=true and ee_params.stochastic_gate_regularization > 0 (T4L used 3.0).",
    "stochastic_gates": {
      "enabled": false,
      "sigma": 0.5,
      "clamp_mu": true
    }
  },
  "training": {
    "_comment": "Training settings from the T4L AIMMD-TIS run (no stochastic gates), with a much shorter epoch budget.",
    "batch_size": 16384,
    "epochs": 300,
    "base_lr": 0.0001,
    "min_lr": 2e-07,
    "plateau_patience": 75,
    "early_stop_patience": 30,
    "min_delta": 0.0001,
    "early_stop_start_epoch": 20,
    "ema_beta": 0.5,
    "train_explosion_factor": 50.0,
    "warmup_epochs": 0,
    "warmup_init": 1e-06,
    "clip_warmup_epochs": 0,
    "weighted_smoothness": true,
    "diag_max_batches": 64,
    "diag_tail_quantile": 99.9,
    "grad_diag_max_batches": 16,
    "optimizer": {
      "type": "adamw",
      "betas": [
        0.9,
        0.95
      ],
      "eps": 1e-07,
      "weight_decay": 0.001
    }
  },
  "run": {
    "n_iterations": 3,
    "convergence": {
      "max_iterations": 12,
      "delta_q_tol": 0.2,
      "patience": 2,
      "q_window": 6.0
    },
    "tps_steps": 100,
    "initial_path_length": 200,
    "stable_steps": 50000,
    "tis_steps": 300,
    "reseed": "previous_iteration",
    "n_workers": null,
    "descriptor_flush_every": 25,
    "thermalization": "first_accepted",
    "n_skip": 30,
    "overlap": 0.2,
    "min_interfaces": 4,
    "interface_overshoot": 1.0,
    "selector": "Gaussian",
    "gaussian_width": 1.0,
    "gaussian_shift": 0.2,
    "warm_start": true,
    "n_bootstrap": 20,
    "block_size": 10
  },
  "analysis": {
    "_comment": "Theory comparison on the reweighted path ensemble; bins with >= min_count frames count as sampled; the logit committor error uses bins with |q_exact| < q_max_logit.",
    "theory_grid": 201,
    "n_bins_2d": 100,
    "min_count": 20,
    "q_max_logit": 10.0,
    "n_bins_q": 1000,
    "grad_q_range": [
      -12,
      12
    ],
    "grad_dq": 0.25
  },
  "quick": {
    "training": {
      "epochs": 40,
      "early_stop_patience": 10
    },
    "run": {
      "n_iterations": 2,
      "tps_steps": 40,
      "stable_steps": 5000,
      "tis_steps": 40,
      "n_skip": 5,
      "n_bootstrap": 5,
      "block_size": 5
    },
    "analysis": {
      "n_bins_2d": 50,
      "min_count": 5,
      "n_bins_q": 200
    }
  }
}
